generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  fullName        String
  major           String
  faculty         String
  rating          Float      @default(0)
  createdAt       DateTime   @default(now())
  buyerChatRooms  ChatRoom[] @relation("ChatRoomBuyer")
  sellerChatRooms ChatRoom[] @relation("ChatRoomSeller")
  materials       Material[]
  sentMessages    Message[]
}

model Material {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String
  courseCode  String
  price       Decimal           @db.Decimal(10, 2)
  condition   MaterialCondition
  status      MaterialStatus    @default(AVAILABLE)
  imageUrls   String[]
  sellerId    String            @db.Uuid
  chatRooms   ChatRoom[]
  seller      User              @relation(fields: [sellerId], references: [id])

  @@index([courseCode])
  @@index([status])
  @@index([sellerId])
}

model ChatRoom {
  id         String    @id @default(uuid()) @db.Uuid
  materialId String    @db.Uuid
  buyerId    String    @db.Uuid
  sellerId   String    @db.Uuid
  createdAt  DateTime  @default(now())
  buyer      User      @relation("ChatRoomBuyer", fields: [buyerId], references: [id])
  material   Material  @relation(fields: [materialId], references: [id])
  seller     User      @relation("ChatRoomSeller", fields: [sellerId], references: [id])
  messages   Message[]

  @@index([materialId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  chatRoomId String   @db.Uuid
  senderId   String   @db.Uuid
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender     User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt])
  @@index([senderId])
}

enum MaterialCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum MaterialStatus {
  AVAILABLE
  RESERVED
  SOLD
}
